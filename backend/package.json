{
  "name": "travel-agency-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the travel agency website. Module-based Express + TypeScript.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "pino-pretty": "13.1.3",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
