# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API (the Next.js site).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (e.g. 1 behind Nginx or a load balancer).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production. In development a random secret is used when empty.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Static admin account (moves to a users table once the database is connected).
# Generate the hash with: npm run hash-password -- "your-strong-password"
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Storage (static mode)
# ---------------------------------------------------------------------------
# Enquiries are saved to this JSON file until a database is connected.
ENQUIRY_STORE_FILE=storage/enquiries.json

# IPs that skip the general rate limiter (e.g. the Next.js server doing SSR/ISR).
RATE_LIMIT_ALLOWLIST=127.0.0.1,::1,::ffff:127.0.0.1
