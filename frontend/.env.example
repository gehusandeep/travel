# Public URL of this website. Used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL used in the browser (RTK Query).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend API base URL used by the Next.js server for SSR/ISR.
# Can point to a private network address in production. Defaults to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000/api/v1

# Seconds before statically generated pages are refreshed in the background (ISR).
REVALIDATE_SECONDS=300
